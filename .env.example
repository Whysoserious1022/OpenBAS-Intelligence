# ============================================================
# OpenBAS Intelligence — Environment Variables
# Copy to .env and configure for your environment.
# NEVER commit .env or secrets to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_USERNAME=openbas
DB_PASSWORD=openbas_secret_change_me

# ── Security ─────────────────────────────────────────────────
# Must be at least 32 characters for JWT signing
JWT_SECRET=openbas-dev-secret-change-in-production-must-be-32chars

# ── MQTT ─────────────────────────────────────────────────────
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── AI Service ───────────────────────────────────────────────
# LLM provider: mock | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Feature Flags ────────────────────────────────────────────
# ALWAYS false unless testing live BACnet equipment in a safe environment
LIVE_EXECUTION_ENABLED=false
AI_SERVICE_ENABLED=true
BACNET_ENABLED=false

# ── Monitoring ───────────────────────────────────────────────
GRAFANA_PASSWORD=admin_change_me

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

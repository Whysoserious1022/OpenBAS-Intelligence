# =====================================================
# OpenBAS Intelligence .gitignore
# =====================================================

# Secrets - NEVER commit these
.env
*.env.local
*.env.production
backend/src/main/resources/application-secret.yml

# Java / Maven
target/
*.class
*.jar
!backend/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/settings.json
.vscode/.ropeproject/
*.suo
*.ntvs*
*.njsproj
*.sln

# Node / React
node_modules/
frontend/dist/
frontend/.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.sql.bak

# Test artifacts
*.xml (surefire)
surefire-reports/
